# Shared application settings. Never commit real credentials.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://recruitment:recruitment@localhost:5432/recruitment
USER_TIMEZONE=Europe/London
LOG_LEVEL=INFO

# Phase 1 Microsoft Graph delegated OAuth.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback
MICROSOFT_CONNECTION_ID=00000000-0000-0000-0000-000000000001

# Base64-encoded 32-byte AES key. In production, inject this from Key Vault.
TOKEN_CACHE_ENCRYPTION_KEY=
TOKEN_CACHE_ENCRYPTION_KEY_VERSION=v1

# Phase 3 link-encryption key is stored as a base64-encoded 32-byte secret in Key Vault.
AZURE_KEY_VAULT_URL=
LINK_ENCRYPTION_KEY_SECRET_NAME=recruitment-link-encryption-key
KEY_VAULT_REQUEST_TIMEOUT_SECONDS=10

# Phase 4 model endpoint. Foundry direct models use https://<resource>.openai.azure.com/openai/v1.
# Production authentication uses the Function managed identity; never configure an API key.
LLM_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_REQUEST_TIMEOUT_SECONDS=30
AZURE_OPENAI_MAX_RETRY_ATTEMPTS=3

GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_REQUEST_TIMEOUT_SECONDS=30
GRAPH_MAX_RETRY_ATTEMPTS=4
GRAPH_MAX_RETRY_DELAY_SECONDS=30

MAIL_FOLDER_ID=inbox
MAIL_SYNC_ENABLED=true
MAIL_SYNC_INTERVAL_MINUTES=10
MAIL_SYNC_SCHEDULE=0 */10 * * * *

# Phase 7 Outlook Calendar writes. Enable only after migration and OAuth re-consent.
CALENDAR_SYNC_ENABLED=false
CALENDAR_INTERVIEW_PLACEHOLDER_MINUTES=60
CALENDAR_ASSESSMENT_PLACEHOLDER_MINUTES=30

# Phase 8 Daily Brief and authenticated Review UI.
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_RECIPIENT=
DAILY_BRIEF_SCHEDULE=0 0 * * * *
DAILY_BRIEF_LOCAL_HOUR=8
PUBLIC_APP_BASE_URL=http://localhost:8000
# Independent Base64-encoded 32-byte HMAC key; never reuse another encryption key.
WEB_SESSION_SIGNING_KEY=
WEB_SESSION_TTL_SECONDS=28800
